# LifeArc environment variables
#
# LifeArc runs fully offline out of the box: the AI service (src/lib/ai.ts)
# uses a deterministic, identity-aware generator so every AI feature works
# with no keys. To upgrade to a live LLM, set the values below and the
# service will call your endpoint, gracefully falling back on any error.

# Enable live AI generation instead of the built-in local generator.
VITE_AI_MODE=local            # "local" | "live"

# Your model endpoint (server proxy recommended so keys never ship to client).
VITE_AI_ENDPOINT=/api/generate
VITE_AI_MODEL=claude-sonnet-5
