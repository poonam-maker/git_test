# ─────────────────────────────────────────────────────────────
# ReelForge environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres) ---
# Local docker:  postgresql://reelforge:reelforge@localhost:5432/reelforge
DATABASE_URL="postgresql://reelforge:reelforge@localhost:5432/reelforge?schema=public"

# --- Auth (NextAuth) ---
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Email / Magic link (optional in dev) ---
# If unset, magic-link emails are logged to the server console instead of sent.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ReelForge <no-reply@reelforge.app>"

# --- File storage ---
# STORAGE_DRIVER = "local" | "s3"
STORAGE_DRIVER="local"
# local driver writes to ./storage and serves via /api/files
LOCAL_STORAGE_DIR="./storage"
# s3 driver (also works with R2 / MinIO — set the endpoint)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- AI provider ---
# AI_PROVIDER = "mock" | "claude"
#   mock   -> fully offline, deterministic, no keys needed (great for dev/demo)
#   claude -> Claude for clip selection + social copy, Whisper for transcription
AI_PROVIDER="mock"
# Claude (clip detection, titles/hooks/hashtags, brand-aware copy)
ANTHROPIC_API_KEY=""
# Defaults to the most capable model; set claude-haiku-4-5 to cut per-clip cost.
ANTHROPIC_MODEL="claude-opus-4-8"
# OpenAI Whisper (speech-to-text only — Anthropic has no audio model)
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# --- Background jobs ---
# JOB_DRIVER = "inline" | "redis"  (inline runs jobs in-process — great for dev)
JOB_DRIVER="inline"
REDIS_URL=""

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs for each paid tier (create these in the Stripe dashboard)
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_CREATOR_PRO=""
STRIPE_PRICE_SMALL_BUSINESS=""
STRIPE_PRICE_AGENCY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
